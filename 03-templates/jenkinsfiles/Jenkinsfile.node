// Node.js: install, lint, test (JUnit + coverage), build
pipeline {
  agent { docker { image 'node:20-alpine'; args '-v npm-cache:/home/node/.npm' } }
  options { timeout(time: 20, unit: 'MINUTES'); timestamps(); buildDiscarder(logRotator(numToKeepStr: '30')) }
  environment {
    CI = 'true'
    npm_config_cache = '/home/node/.npm'
  }
  stages {
    stage('Install') { steps { sh 'npm ci --no-audit --prefer-offline' } }
    stage('Checks') {
      parallel {
        stage('Lint') { steps { sh 'npm run lint -- --format junit -o reports/eslint.xml || true' } }
        stage('Test') { steps { sh 'npx jest --ci --coverage --reporters=default --reporters=jest-junit' } }
      }
    }
    stage('Build') { steps { sh 'npm run build' } }
  }
  post {
    always {
      junit allowEmptyResults: true, testResults: 'junit.xml, reports/*.xml'
      recordCoverage tools: [[parser: 'COBERTURA', pattern: 'coverage/cobertura-coverage.xml']]
    }
    cleanup { cleanWs() }
  }
}
